{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "strict": true,
    "noEmit": true,
    "types": ["node"],
    // `esphome-config` imports in this repo resolve to src, not dist
    "customConditions": ["esphome-config-source"]
  },
  "include": ["src", "test", "scripts"],
  // needs the Roode schema dump, which the Nix check generates
  "exclude": ["test/roode"]
}
