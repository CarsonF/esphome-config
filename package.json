{
  "name": "esphome-config",
  "version": "0.0.0",
  "description": "Write ESPHome configs in TypeScript, with types from ESPHome's own schema",
  "keywords": [
    "esphome",
    "typescript",
    "home-automation",
    "iot",
    "dsl"
  ],
  "homepage": "https://github.com/CarsonF/esphome-config#readme",
  "bugs": "https://github.com/CarsonF/esphome-config/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CarsonF/esphome-config.git"
  },
  "license": "MIT",
  "author": "Carson Full <carson@full.family>",
  "type": "module",
  "esphome": {
    "version": "2026.9.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./registry": {
      "types": "./dist/generated/registry.d.ts",
      "default": "./dist/generated/registry.js"
    },
    "./generated/*": {
      "types": "./dist/generated/*.d.ts",
      "default": "./dist/generated/*.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "esphome-config": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "generate": "node src/cli.ts generate",
    "typecheck": "tsc",
    "test": "node --test \"test/**/*.test.ts\"",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "remeda": "^2.58.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  }
}
